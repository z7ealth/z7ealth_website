<div class="grid gap-4 sm:grid-cols-3">
  <div
    :for={
      {name, tagline, description, url, homepage} <- [
        {"kubevirt-tools", "RVTools-inspired inventory for KubeVirt",
         "Open-source utility for KubeVirt / OpenShift Virtualization environments, focused on inventory, visibility, and assessment of Kubernetes-native virtualization platforms.",
         "https://github.com/z7ealth", nil},
        {"extop", "Elixir/BEAM terminal system monitor",
         "Terminal system monitor for Linux written in Elixir, in the spirit of btop. Built on the BEAM with a ratatui-based TUI.",
         "https://github.com/z7ealth", nil},
        {"EXKL", "Open Linux service for DeepCool AK coolers",
         "Open-source Linux alternative to DeepCool's proprietary control software, enabling monitoring and display support for AK-series digital coolers. Built with Elixir, Phoenix, and LiveView.",
         "https://github.com/z7ealth", nil},
        {"PhoenixPaper", "Material Design components for Phoenix",
         "A Material Design component library for Phoenix, in the spirit of ember-paper, styled with Tailwind CSS. Includes a live component catalog and LiveView-ready UI elements.",
         "https://github.com/z7ealth/phoenix_paper", "https://phoenixpaper.dev"}
      ]
    }
    class="card bg-base-200/60 border border-base-300 hover:border-primary/50 transition-colors"
  >
    <div class="card-body gap-2 p-6">
      <h3 class="card-title text-base-content">{name}</h3>
      <p class="text-sm font-semibold uppercase tracking-wide text-primary/80">{tagline}</p>
      <p class="text-base text-justify text-base-content/80">{description}</p>
      <div class="card-actions pt-2 gap-4">
        <a
          :if={homepage}
          href={homepage}
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary text-sm font-semibold"
        >
          Visit Site ↗
        </a>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="link link-primary text-sm font-semibold"
        >
          View on GitHub ↗
        </a>
      </div>
    </div>
  </div>
</div>
