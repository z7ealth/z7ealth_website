<div class="card bg-base-200/60 border border-base-300 hover:border-primary/50 transition-colors">
  <div class="card-body gap-3 p-6">
    <h3 class="card-title text-base-content text-lg">{@title}</h3>
    <div class="flex flex-wrap gap-2">
      <span :for={skill <- @skills} class="badge badge-lg badge-outline border-base-300 text-base-content/80">
        {skill}
      </span>
    </div>
  </div>
</div>
